{
	"name": "snakebench",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"check": "turbo run check",
		"deploy": "turbo run deploy",
		"bench": "bun run --cwd apps/worker bench"
	},
	"devDependencies": {
		"turbo": "^2.11.7"
	}
}
